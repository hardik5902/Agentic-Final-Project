{
  "category_id": "saas_tools",
  "category_name": "SaaS Tools & Software",
  "subcategories": ["crm", "erp", "project_management", "analytics", "communication", "security"],
  "required_fields": ["tool_type", "num_users", "budget_annual", "required_features", "implementation_timeline_weeks"],
  "optional_fields": ["existing_integrations", "data_migration_needed", "sso_required", "compliance_requirements"],
  "response_form_fields": [
    {"field_id": "product_name", "label": "Product Name", "type": "text", "required": true},
    {"field_id": "pricing_model", "label": "Pricing Model", "type": "dropdown", "required": true, "options": ["Per user/month", "Flat annual", "Usage-based", "Tiered"]},
    {"field_id": "annual_cost", "label": "Annual Cost (USD)", "type": "number", "required": true, "hint": "Total annual cost for your required number of users"},
    {"field_id": "currency", "label": "Currency", "type": "dropdown", "required": true, "options": ["USD", "EUR", "GBP"]},
    {"field_id": "implementation_weeks", "label": "Implementation Timeline (weeks)", "type": "number", "required": true},
    {"field_id": "features_included", "label": "Key Features Included", "type": "textarea", "required": true, "hint": "List the features from our requirements that are included out-of-the-box", "max_words": 300},
    {"field_id": "features_missing", "label": "Features Not Included", "type": "textarea", "required": false, "hint": "List any requested features that require add-ons or customization"},
    {"field_id": "integration_capabilities", "label": "Integration Capabilities", "type": "textarea", "required": false, "hint": "Describe API and native integrations available"},
    {"field_id": "support_tier", "label": "Support Tier Included", "type": "dropdown", "required": true, "options": ["Email only", "Chat + Email", "Phone + Chat + Email", "Dedicated CSM"]},
    {"field_id": "uptime_sla", "label": "Uptime SLA (%)", "type": "number", "required": false},
    {"field_id": "sso_supported", "label": "SSO Supported?", "type": "boolean", "required": false},
    {"field_id": "contract_length", "label": "Minimum Contract Length", "type": "dropdown", "required": true, "options": ["Month-to-month", "Annual", "2 years", "3 years"]},
    {"field_id": "demo_link", "label": "Demo / Trial Link", "type": "url_list", "required": false}
  ],
  "normalization_rules": {
    "annual_cost": {"type": "currency_convert"},
    "implementation_weeks": {"type": "time_standardize", "unit": "weeks"}
  },
  "default_evaluation_criteria": [
    {"name": "features_match", "label": "Features Match", "weight": 0.30, "type": "buyer_rated"},
    {"name": "price", "label": "Annual Cost", "weight": 0.30, "type": "calculated"},
    {"name": "timeline", "label": "Implementation Timeline", "weight": 0.20, "type": "calculated"},
    {"name": "support_quality", "label": "Support Quality", "weight": 0.10, "type": "buyer_rated"},
    {"name": "contract_flexibility", "label": "Contract Flexibility", "weight": 0.10, "type": "buyer_rated"}
  ],
  "compliance_checks": [
    {"check": "budget_compliance", "eliminates": true, "message": "Annual cost exceeds maximum budget"},
    {"check": "timeline_compliance", "eliminates": true, "message": "Implementation timeline exceeds requirement"}
  ]
}
